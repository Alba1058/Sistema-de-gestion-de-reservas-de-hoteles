@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Hotel Management - Sign In</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #1A2B4C, #3EB7B3);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Poppins', sans-serif;
        }

        .login-container {
            width: 900px;
            height: 500px;
            background: #fff;
            border-radius: 25px;
            overflow: hidden;
            display: flex;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .left-panel {
            flex: 1;
            padding: 40px;
            background: linear-gradient(135deg, #1A2B4C, #3EB7B3);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

            .left-panel h1 {
                font-size: 42px;
                font-weight: 700;
            }

            .left-panel p {
                font-size: 16px;
                opacity: 0.85;
                max-width: 300px;
            }

            .left-panel .decor {
                position: absolute;
                width: 90%;
                height: 90%;
                top: 5%;
                left: 5%;
                background: radial-gradient(circle at top left, rgba(255,255,255,0.2), transparent 70%);
                border-radius: 50px;
            }

        .right-panel {
            flex: 1;
            padding: 45px 55px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .right-panel h3 {
                font-weight: 600;
                color: #1A2B4C;
                margin-bottom: 25px;
            }

        .form-control {
            border-radius: 25px;
            height: 48px;
            padding-left: 20px;
        }

        .btn-login {
            width: 100%;
            height: 48px;
            border-radius: 25px;
            border: none;
            background: linear-gradient(135deg, #1A2B4C, #3EB7B3);
            color: white;
            font-size: 17px;
            margin-top: 10px;
        }

            .btn-login:hover {
                opacity: 0.9;
            }

        .forgot {
            float: right;
            font-size: 13px;
            color: #1A2B4C;
        }
    </style>
</head>

<body>

    <div class="login-container">

        <!-- LEFT HOTEL PANEL -->
        <div class="left-panel">
            <div class="decor"></div>
            <h1>Welcome Back!</h1>
            <p>Access your hotel management system and continue managing reservations, guests, and services.</p>
        </div>

        <!-- RIGHT LOGIN PANEL -->
        <div class="right-panel">
            <h3>Sign In</h3>

            <form method="post">

                <div class="mb-3">
                    <input type="text" name="correo" class="form-control" placeholder="Username or Email">
                </div>

                <div class="mb-3">
                    <input type="password" name="contraseña" class="form-control" placeholder="Password">
                </div>

                <div class="d-flex justify-content-between">
                    <div>
                        <input type="checkbox"> Remember me
                    </div>
                    <a href="#" class="forgot">Forgot password?</a>
                </div>

                <button type="submit" class="btn-login">Sign In</button>

                <p class="text-center mt-3" style="font-size: 14px;">
                    New here?
                    <a href="#" style="color:#3EB7B3;">Create an account</a>
                </p>

            </form>
        </div>

    </div>

</body>
</html>
