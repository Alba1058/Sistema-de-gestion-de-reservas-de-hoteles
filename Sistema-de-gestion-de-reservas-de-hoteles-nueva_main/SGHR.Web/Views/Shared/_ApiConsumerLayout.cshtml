@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Modo Prueba - API Consumer | SGHR</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" crossorigin="anonymous">

    <style>
        body {
            background: #F5F7FA;
            font-family: 'Segoe UI', sans-serif;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            height: 100vh;
            background: #1B2A49;
            color: #fff;
            position: fixed;
            left: 0;
            top: 0;
            padding: 30px 20px;
        }

            .sidebar .profile {
                text-align: center;
                margin-bottom: 40px;
            }

                .sidebar .profile img {
                    width: 85px;
                    height: 85px;
                    border-radius: 50%;
                    border: 3px solid #FFC857;
                }

                .sidebar .profile h4 {
                    margin-top: 10px;
                    margin-bottom: 5px;
                }

            .sidebar a {
                display: block;
                padding: 12px 15px;
                margin-bottom: 8px;
                border-radius: 8px;
                color: #d7dce5;
                text-decoration: none;
                font-size: 15px;
                transition: .25s;
            }

                .sidebar a:hover {
                    background: #4A6FA5;
                    color: #fff;
                }

                .sidebar a.logout {
                    background: #E63946;
                    font-weight: bold;
                    color: white;
                }

                    .sidebar a.logout:hover {
                        background: #c92f3c;
                    }

            .sidebar .mode-badge {
                background: #FFC857;
                color: #1B2A49;
                padding: 8px 12px;
                border-radius: 6px;
                font-size: 11px;
                font-weight: bold;
                text-align: center;
                margin-bottom: 20px;
                text-transform: uppercase;
            }

        /* CONTENT */
        .content {
            margin-left: 260px;
            padding: 40px 50px;
        }

        .dashboard-title {
            font-size: 28px;
            font-weight: bold;
            color: #1B2A49;
        }

        /* CARDS */
        .info-card {
            background: #fff;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 2px 10px rgb(0 0 0 / 10%);
            transition: transform .2s;
        }

            .info-card:hover {
                transform: translateY(-5px);
            }

            .info-card .icon {
                font-size: 30px;
                color: #4A6FA5;
            }

        .chart-box {
            background: #fff;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 2px 10px rgb(0 0 0 / 10%);
            height: 350px;
        }

    </style>
</head>
<body>
    <div class="sidebar">
        <div class="mode-badge">
            <i class="bi bi-tools"></i> Modo Prueba / API Consumer
        </div>

        <a href="@Url.Action("App", "Home")"><i class="bi bi-house-door"></i> Inicio</a>

        <div style="margin-top: 10px; margin-bottom: 10px; padding-left: 15px; color: #8a9db8; font-size: 12px; font-weight: bold; text-transform: uppercase;">Reservas</div>
        <a href="@Url.Action("Index", "HabitacionApi")"><i class="bi bi-bed"></i> Habitaciones</a>
        <a href="@Url.Action("Index", "ReservaApi")"><i class="bi bi-calendar-check"></i> Reservas</a>
        <a href="@Url.Action("Index", "TarifaApi")"><i class="bi bi-tag"></i> Tarifas</a>
        <a href="@Url.Action("Index", "PagoApi")"><i class="bi bi-credit-card"></i> Pagos</a>
        <a href="@Url.Action("Index", "ServicioAdicionalApi")"><i class="bi bi-plus-circle"></i> Servicios Adicionales</a>

        <div style="margin-top: 15px; margin-bottom: 10px; padding-left: 15px; color: #8a9db8; font-size: 12px; font-weight: bold; text-transform: uppercase;">Gestión</div>
        <a href="@Url.Action("Index", "ClienteApi")"><i class="bi bi-people"></i> Clientes</a>
        <a href="@Url.Action("Index", "UsuarioApi")"><i class="bi bi-person-badge"></i> Usuarios</a>

        <div style="margin-top: 15px; margin-bottom: 10px; padding-left: 15px; color: #8a9db8; font-size: 12px; font-weight: bold; text-transform: uppercase;">Configuración</div>
        <a href="@Url.Action("Index", "CategoriaApi")"><i class="bi bi-grid"></i> Categorías</a>
        <a href="@Url.Action("Index", "PisoApi")"><i class="bi bi-building"></i> Pisos</a>
        <a href="@Url.Action("Index", "RolUsuarioApi")"><i class="bi bi-shield-check"></i> Roles de Usuario</a>

        <a href="@Url.Action("Index", "Home")" class="logout" style="margin-top: 20px;"><i class="bi bi-arrow-left"></i> Volver a Selección</a>
    </div>

    <div class="content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>

