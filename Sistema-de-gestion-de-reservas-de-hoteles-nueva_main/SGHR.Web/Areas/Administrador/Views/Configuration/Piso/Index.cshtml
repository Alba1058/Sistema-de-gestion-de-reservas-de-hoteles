@model List<SGHR.Application.DTOs.Configuration.Piso.PisoDTO>

@{
    ViewData["Title"] = "Pisos";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<h2 class="mt-3">Listado de Pisos</h2>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrorMessage
    </div>
}

<a asp-action="Create" class="btn btn-primary mb-3">Nuevo Piso</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Número</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var piso in Model)
            {
                <tr>
                    <td>@piso.Id</td>
                    <td>@piso.Numero</td>
                    <td>@(piso.Descripcion ?? "Sin descripción")</td>
                    <td>
                        @if (piso.Estado)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@piso.Id" class="btn btn-info btn-sm">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@piso.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@piso.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No hay pisos registrados</td>
            </tr>
        }
    </tbody>
</table>

