@model SGHR.Application.DTOs.Clientes.Cliente.ClienteCreateDTO

@{
    ViewData["Title"] = "Crear Nuevo Cliente";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-person-plus"></i> Crear Nuevo Cliente
                    </h4>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-warning">
                            <strong><i class="bi bi-exclamation-triangle"></i> Errores de validación:</strong>
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-action="Create" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Nombre" class="form-label fw-bold">
                                    <i class="bi bi-person"></i> Nombre
                                </label>
                                <input asp-for="Nombre" class="form-control form-control-lg" required />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Apellido" class="form-label fw-bold">
                                    <i class="bi bi-person"></i> Apellido
                                </label>
                                <input asp-for="Apellido" class="form-control form-control-lg" required />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">
                                    <i class="bi bi-envelope"></i> Email
                                </label>
                                <input asp-for="Email" class="form-control form-control-lg" type="email" required />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label fw-bold">
                                    <i class="bi bi-telephone"></i> Teléfono
                                </label>
                                <input asp-for="Telefono" class="form-control form-control-lg" type="tel" required />
                                <span asp-validation-for="Telefono" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Identificacion" class="form-label fw-bold">
                                    <i class="bi bi-card-text"></i> Identificación
                                </label>
                                <input asp-for="Identificacion" class="form-control form-control-lg" required />
                                <span asp-validation-for="Identificacion" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Direccion" class="form-label fw-bold">
                                    <i class="bi bi-geo-alt"></i> Dirección (Opcional)
                                </label>
                                <input asp-for="Direccion" class="form-control form-control-lg" />
                                <span asp-validation-for="Direccion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Guardar Cliente
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function(form) {
                form.addEventListener('submit', function(event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}
