@model List<SGHR.Application.DTOs.Clientes.Cliente.ClienteDTO>

@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="dashboard-title mb-1">
                <i class="bi bi-people"></i> Gestión de Clientes
            </h2>
            <p class="text-muted mb-0">Administra los clientes del hotel</p>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-primary btn-lg">
            <i class="bi bi-person-plus"></i> Nuevo Cliente
        </a>
    </div>

    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tarjetas de resumen -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block">Total Clientes</small>
                            <h3 class="mb-0">@Model.Count</h3>
                        </div>
                        <div class="text-primary" style="font-size: 2.5rem;">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block">Con Email</small>
                            <h3 class="mb-0 text-info">@Model.Count(c => !string.IsNullOrEmpty(c.Email))</h3>
                        </div>
                        <div class="text-info" style="font-size: 2.5rem;">
                            <i class="bi bi-envelope"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block">Con Dirección</small>
                            <h3 class="mb-0 text-success">@Model.Count(c => !string.IsNullOrEmpty(c.Direccion))</h3>
                        </div>
                        <div class="text-success" style="font-size: 2.5rem;">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de clientes -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><i class="bi bi-person"></i> Nombre Completo</th>
                                <th><i class="bi bi-envelope"></i> Email</th>
                                <th><i class="bi bi-telephone"></i> Teléfono</th>
                                <th><i class="bi bi-card-text"></i> Identificación</th>
                                <th><i class="bi bi-geo-alt"></i> Dirección</th>
                                <th class="text-center" style="min-width: 400px;"><i class="bi bi-gear"></i> Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle bg-primary text-white me-2">
                                                @(cliente.Nombre[0].ToString().ToUpper())
                                            </div>
                                            <div>
                                                <strong>@cliente.Nombre @cliente.Apellido</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="mailto:@cliente.Email" class="text-decoration-none">
                                            <i class="bi bi-envelope"></i> @cliente.Email
                                        </a>
                                    </td>
                                    <td>
                                        <a href="tel:@cliente.Telefono" class="text-decoration-none">
                                            <i class="bi bi-telephone"></i> @cliente.Telefono
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@cliente.Identificacion</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(cliente.Direccion))
                                        {
                                            <span class="text-muted"><i class="bi bi-geo-alt"></i> @cliente.Direccion</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 justify-content-center">
                                            <a href="@Url.Action("Details", new { id = cliente.Id })" 
                                               class="btn btn-info btn-lg px-3" 
                                               title="Ver detalles">
                                                <i class="bi bi-eye-fill"></i> Detalles
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = cliente.Id })" 
                                               class="btn btn-warning btn-lg px-3" 
                                               title="Editar">
                                                <i class="bi bi-pencil-fill"></i> Editar
                                            </a>
                                            <a href="@Url.Action("Delete", new { id = cliente.Id })" 
                                               class="btn btn-danger btn-lg px-3" 
                                               title="Eliminar">
                                                <i class="bi bi-trash-fill"></i> Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people" style="font-size: 4rem; color: #ccc;"></i>
                    <p class="text-muted mt-3 mb-0">No hay clientes registrados</p>
                    <a href="@Url.Action("Create")" class="btn btn-primary mt-3">
                        <i class="bi bi-person-plus"></i> Crear Primer Cliente
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        padding: 1rem !important;
    }
    
    .table td {
        padding: 1rem !important;
        vertical-align: middle;
    }
    
    .table tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s;
    }
    
    .card {
        border-radius: 10px;
    }
    
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.1rem;
    }
    
    .btn-lg {
        font-size: 1rem;
        padding: 0.5rem 1rem;
        font-weight: 500;
        white-space: nowrap;
    }
    
    .btn-lg i {
        margin-right: 0.25rem;
    }
</style>
