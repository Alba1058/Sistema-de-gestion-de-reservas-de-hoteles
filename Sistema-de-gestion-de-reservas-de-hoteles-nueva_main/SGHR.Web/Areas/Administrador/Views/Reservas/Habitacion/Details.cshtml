@model SGHR.Application.DTOs.Reservas.Habitacion.HabitacionDTO
@using SGHR.Application.DTOs.Configuration.Categoria
@using SGHR.Application.DTOs.Configuration.Piso
@using SGHR.Domain.Enums

@{
    ViewData["Title"] = "Detalles de Habitación";
    var categorias = ViewBag.Categorias as List<CategoriaDTO> ?? new List<CategoriaDTO>();
    var pisos = ViewBag.Pisos as List<PisoDTO> ?? new List<PisoDTO>();
    var categoria = categorias.FirstOrDefault(c => c.Id == Model.IdCategoria);
    var piso = pisos.FirstOrDefault(p => p.Id == Model.IdPiso);
    var estadoHabitacion = (EstadoHabitacion)Model.EstadoHabitacion;
    
    var estadoClass = estadoHabitacion switch
    {
        EstadoHabitacion.Disponible => "success",
        EstadoHabitacion.Ocupada => "warning",
        EstadoHabitacion.Limpieza => "info",
        EstadoHabitacion.Mantenimiento => "danger",
        EstadoHabitacion.Reservada => "primary",
        EstadoHabitacion.Inactiva => "secondary",
        _ => "secondary"
    };
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-info text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-info-circle"></i> Detalles de Habitación #@Model.Numero
                        </h4>
                        <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- Información Principal -->
                        <div class="col-md-6">
                            <div class="card border-0 bg-light h-100">
                                <div class="card-body">
                                    <h5 class="card-title mb-4">
                                        <i class="bi bi-card-heading"></i> Información Principal
                                    </h5>
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5 text-muted">ID:</dt>
                                        <dd class="col-sm-7"><strong>#@Model.Id</strong></dd>

                                        <dt class="col-sm-5 text-muted">Número:</dt>
                                        <dd class="col-sm-7">
                                            <span class="badge bg-primary fs-6">#@Model.Numero</span>
                                        </dd>

                                        <dt class="col-sm-5 text-muted">Precio Base:</dt>
                                        <dd class="col-sm-7">
                                            <span class="badge bg-success fs-6">@Model.PrecioBase.ToString("C")</span>
                                        </dd>

                                        <dt class="col-sm-5 text-muted">Estado:</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.Estado)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Activa</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Inactiva</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <!-- Información de Ubicación y Estado -->
                        <div class="col-md-6">
                            <div class="card border-0 bg-light h-100">
                                <div class="card-body">
                                    <h5 class="card-title mb-4">
                                        <i class="bi bi-geo-alt"></i> Ubicación y Estado
                                    </h5>
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5 text-muted">Categoría:</dt>
                                        <dd class="col-sm-7">
                                            <span class="badge bg-info">@(categoria?.Nombre ?? $"Categoría {Model.IdCategoria}")</span>
                                        </dd>

                                        <dt class="col-sm-5 text-muted">Piso:</dt>
                                        <dd class="col-sm-7">
                                            <span class="badge bg-secondary">Piso @(piso?.Numero ?? Model.IdPiso)</span>
                                        </dd>

                                        <dt class="col-sm-5 text-muted">Estado Habitación:</dt>
                                        <dd class="col-sm-7">
                                            <span class="badge bg-@estadoClass">@estadoHabitacion.ToString()</span>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <!-- Descripción -->
                        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                        {
                            <div class="col-12">
                                <div class="card border-0 bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title mb-3">
                                            <i class="bi bi-card-text"></i> Descripción
                                        </h5>
                                        <p class="mb-0">@Model.Descripcion</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Acciones -->
                    <div class="d-flex gap-2 mt-4 pt-3 border-top">
                        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a href="@Url.Action("Delete", new { id = Model.Id })" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-auto">
                            <i class="bi bi-arrow-left"></i> Volver al Listado
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

