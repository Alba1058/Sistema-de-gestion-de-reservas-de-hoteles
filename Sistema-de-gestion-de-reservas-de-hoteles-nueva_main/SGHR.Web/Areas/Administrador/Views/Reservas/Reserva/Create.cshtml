@model SGHR.Application.DTOs.Reservas.Reserva.CreateReservaDTO

@{
    ViewData["Title"] = "Crear Reserva";
}

<h2 class="mt-3">Crear Reserva</h2>

<form asp-action="Create" method="post" class="mt-3">

    <div class="mb-3">
        <label class="form-label">Cliente</label>
        <input asp-for="IdCliente" class="form-control" />
        <span asp-validation-for="IdCliente" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Habitación</label>
        <input asp-for="IdHabitacion" class="form-control" />
        <span asp-validation-for="IdHabitacion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha Inicio</label>
        <input asp-for="FechaInicio" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha Fin</label>
        <input asp-for="FechaFin" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Número de Huéspedes</label>
        <input asp-for="NumeroHuespedes" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Total</label>
        <input asp-for="Total" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Estado Reserva</label>
        <select asp-for="EstadoReserva" class="form-select">
            <option value="0">Activa</option>
            <option value="1">Cancelada</option>
            <option value="2">Finalizada</option>
        </select>
    </div>

    <button class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
