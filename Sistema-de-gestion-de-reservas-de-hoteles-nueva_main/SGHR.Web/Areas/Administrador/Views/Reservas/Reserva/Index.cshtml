@model List<SGHR.Application.DTOs.Reservas.Reserva.ReservaDTO>

@{
    ViewData["Title"] = "Reservas";
}

<h2 class="mt-3">Listado de Reservas</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Nueva Reserva</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Cliente</th>
            <th>Habitación</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Total</th>
            <th>Estado Reserva</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.IdCliente</td>
                <td>@r.IdHabitacion</td>
                <td>@r.FechaInicio.ToShortDateString()</td>
                <td>@r.FechaFin.ToShortDateString()</td>
                <td>@r.Total</td>
                <td>@r.EstadoReserva</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-danger btn-sm">Borrar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
