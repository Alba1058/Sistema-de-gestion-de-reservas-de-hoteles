@model List<SGHR.Application.DTOs.Reservas.Tarifa.TarifaDTO>

@{
    ViewData["Title"] = "Tarifas";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<h2 class="mt-3">Listado de Tarifas</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Nueva Tarifa</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tipo</th>
            <th>Monto</th>
            <th>Precio por Noche</th>
            <th>Descuento</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>ID Habitación</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var tarifa in Model)
            {
                <tr>
                    <td>@tarifa.Id</td>
                    <td>@tarifa.Tipo</td>
                    <td>@tarifa.Monto.ToString("C")</td>
                    <td>@tarifa.PrecioPorNoche.ToString("C")</td>
                    <td>@tarifa.Descuento.ToString("P")</td>
                    <td>@tarifa.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@tarifa.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td>@tarifa.IdHabitacion</td>
                    <td>
                        @if (tarifa.Estado)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactiva</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@tarifa.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@tarifa.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="text-center">No hay tarifas registradas</td>
            </tr>
        }
    </tbody>
</table>

