@model List<SGHR.Application.DTOs.Reservas.ServicioAdicional.ServicioAdicionalDTO>

@{
    ViewData["Title"] = "Servicios Adicionales";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<h2 class="mt-3">Listado de Servicios Adicionales</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Nuevo Servicio Adicional</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var servicio in Model)
            {
                <tr>
                    <td>@servicio.Id</td>
                    <td>@servicio.Nombre</td>
                    <td>@servicio.Precio.ToString("C")</td>
                    <td>@(servicio.Descripcion ?? "Sin descripción")</td>
                    <td>
                        @if (servicio.Estado)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@servicio.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@servicio.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No hay servicios adicionales registrados</td>
            </tr>
        }
    </tbody>
</table>

