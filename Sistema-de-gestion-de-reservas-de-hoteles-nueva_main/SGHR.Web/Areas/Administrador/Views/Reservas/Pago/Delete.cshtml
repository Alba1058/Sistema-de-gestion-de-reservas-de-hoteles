@model SGHR.Application.DTOs.Reservas.Pago.PagoDTO

@{
    ViewData["Title"] = "Eliminar Pago";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<h2 class="mt-3 text-danger">¿Seguro que deseas eliminar este pago?</h2>

<div class="border p-3 mt-3">
    <h4>Información del Pago</h4>
    <dl class="row">
        <dt class="col-sm-3">ID:</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">ID Reserva:</dt>
        <dd class="col-sm-9">@Model.IdReserva</dd>

        <dt class="col-sm-3">Monto:</dt>
        <dd class="col-sm-9">@Model.Monto.ToString("C")</dd>

        <dt class="col-sm-3">Fecha de Pago:</dt>
        <dd class="col-sm-9">@Model.FechaPago.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">Método:</dt>
        <dd class="col-sm-9">@Model.Metodo</dd>

        <dt class="col-sm-3">Confirmado:</dt>
        <dd class="col-sm-9">
            @if (Model.Confirmado)
            {
                <span class="badge bg-success">Sí</span>
            }
            else
            {
                <span class="badge bg-warning">No</span>
            }
        </dd>

        <dt class="col-sm-3">Estado:</dt>
        <dd class="col-sm-9">
            @if (Model.Estado)
            {
                <span class="badge bg-success">Activo</span>
            }
            else
            {
                <span class="badge bg-danger">Inactivo</span>
            }
        </dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

