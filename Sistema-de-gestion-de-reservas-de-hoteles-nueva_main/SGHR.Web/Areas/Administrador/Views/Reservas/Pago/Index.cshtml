@model List<SGHR.Application.DTOs.Reservas.Pago.PagoDTO>

@{
    ViewData["Title"] = "Pagos";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<h2 class="mt-3">Listado de Pagos</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Nuevo Pago</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>ID Reserva</th>
            <th>Monto</th>
            <th>Fecha Pago</th>
            <th>Método</th>
            <th>Confirmado</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var pago in Model)
            {
                <tr>
                    <td>@pago.Id</td>
                    <td>@pago.IdReserva</td>
                    <td>@pago.Monto.ToString("C")</td>
                    <td>@pago.FechaPago.ToShortDateString()</td>
                    <td>@pago.Metodo</td>
                    <td>
                        @if (pago.Confirmado)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">No</span>
                        }
                    </td>
                    <td>
                        @if (pago.Estado)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@pago.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@pago.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">No hay pagos registrados</td>
            </tr>
        }
    </tbody>
</table>

