@model SGHR.Application.DTOs.Reservas.Pago.UpdatePagoDTO

@{
    ViewData["Title"] = "Editar Pago";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<h2 class="mt-3">Editar Pago</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<form asp-action="Edit" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="IdReserva" class="form-label">ID Reserva</label>
        <input asp-for="IdReserva" class="form-control" type="number" />
        <span asp-validation-for="IdReserva" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Monto" class="form-label">Monto</label>
        <input asp-for="Monto" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaPago" class="form-label">Fecha de Pago</label>
        <input asp-for="FechaPago" class="form-control" type="datetime-local" />
        <span asp-validation-for="FechaPago" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Metodo" class="form-label">Método de Pago</label>
        <input asp-for="Metodo" class="form-control" />
        <span asp-validation-for="Metodo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select">
            <option value="true">Activo</option>
            <option value="false">Inactivo</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

