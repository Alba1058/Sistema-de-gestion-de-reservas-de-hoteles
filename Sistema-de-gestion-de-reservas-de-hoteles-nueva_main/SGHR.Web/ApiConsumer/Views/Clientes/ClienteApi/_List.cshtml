@model IEnumerable<SGHR.Application.DTOs.Clientes.Cliente.ClienteDTO>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                <th>@Html.DisplayNameFor(model => model.Apellido)</th>
                <th>@Html.DisplayNameFor(model => model.Identificacion)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Id</td>
                        <td class="fw-bold">@cliente.Nombre</td>
                        <td>@cliente.Apellido</td>
                        <td>@cliente.Identificacion</td>
                        <td>@cliente.Email</td>
                        <td class="text-nowrap text-center">
                            <a href="@Url.Action("Details", "ClienteApi", new { id = cliente.Id })" class="btn btn-outline-info btn-sm me-1">
                                <i class="bi bi-eye"></i> Detalles
                            </a>
                            <a href="@Url.Action("Edit", "ClienteApi", new { id = cliente.Id })" class="btn btn-outline-warning btn-sm me-1">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="openDeleteModal(@cliente.Id)">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4">
                        <div class="text-muted">
                            <i class="bi bi-person-fill" style="font-size: 2rem;"></i>
                            <p class="mt-2">No hay clientes registrados</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>