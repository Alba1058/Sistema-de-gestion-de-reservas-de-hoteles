@model SGHR.Application.DTOs.Configuration.RolUsuario.RolUsuarioDTO

@{
    ViewData["Title"] = "Detalles del Rol";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-info-circle"></i> Detalles del Rol: @Model.Nombre
                    </h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">ID:</dt>
                        <dd class="col-sm-8"><strong>@Model.Id</strong></dd>

                        <dt class="col-sm-4 text-muted">Nombre:</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>

                        <dt class="col-sm-4 text-muted">Descripción:</dt>
                        <dd class="col-sm-8">@Model.Descripcion</dd>

                        <dt class="col-sm-4 text-muted">Estado:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Estado)
                            {
                                <span class="badge rounded-pill bg-success fs-6">Activo</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary fs-6">Inactivo</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Edit", "RolUsuarioApi", new { id = Model.Id })" class="btn btn-outline-warning">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a href="@Url.Action("Index", "RolUsuarioApi")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Volver a la lista
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>