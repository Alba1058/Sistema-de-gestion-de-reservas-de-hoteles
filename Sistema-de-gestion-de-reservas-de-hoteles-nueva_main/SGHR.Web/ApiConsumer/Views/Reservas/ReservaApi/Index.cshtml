@model List<SGHR.Application.DTOs.Reservas.Reserva.ReservaDTO>

@{
    ViewData["Title"] = "Reservas";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="bi bi-calendar-check"></i> Gestión de Reservas
        </h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a href="@Url.Action("Create", "ReservaApi")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva Reserva
        </a>
    </div>

    <div id="reserva-list-container">
        @await Html.PartialAsync("_List", Model ?? new List<SGHR.Application.DTOs.Reservas.Reserva.ReservaDTO>())
    </div>
</div>

@Html.AntiForgeryToken()

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" id="deleteModalContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.openDeleteModal = function(id) {
            console.log('openDeleteModal llamado con id:', id);
            if (!id || id <= 0) {
                alert('ID de reserva inválido');
                return;
            }
            
            if (typeof $ === 'undefined') {
                console.error('jQuery no está disponible');
                alert('Error: jQuery no está cargado');
                return;
            }
            
            if (typeof bootstrap === 'undefined') {
                console.error('Bootstrap no está disponible');
                alert('Error: Bootstrap no está cargado');
                return;
            }
            
            $.get('@Url.Action("_Delete", "ReservaApi")', { id: id })
                .done(function (html) {
                    console.log('Modal cargado correctamente');
                    $("#deleteModalContent").html(html);
                    var modalElement = document.getElementById('deleteModal');
                    if (!modalElement) {
                        console.error('No se encontró el elemento deleteModal');
                        alert('Error: No se encontró el modal');
                        return;
                    }
                    var existingModal = bootstrap.Modal.getInstance(modalElement);
                    if (existingModal) {
                        existingModal.dispose();
                    }
                    var modal = new bootstrap.Modal(modalElement);
                    modal.show();
                })
                .fail(function (xhr, status, error) {
                    console.error('Error al cargar modal:', error, xhr);
                    alert('Error al cargar el modal de eliminación: ' + (xhr.responseJSON?.message || error));
                });
        };
        
        window.deleteConfirmed = function(id) {
            console.log('deleteConfirmed llamado con id:', id);
            var token = $('input[name="__RequestVerificationToken"]').first().val();
            
            if (!token) {
                token = $('#deleteModalContent input[name="__RequestVerificationToken"]').first().val();
            }
            
            if (!token) {
                alert('Error: No se pudo obtener el token de seguridad. Por favor, recargue la página.');
                return;
            }
            
            $.ajax({
                url: '@Url.Action("_DeleteConfirmed", "ReservaApi")',
                type: 'POST',
                dataType: 'json',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: { 
                    id: id, 
                    __RequestVerificationToken: token 
                },
                success: function (response) {
                    var modalElement = document.getElementById('deleteModal');
                    var modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) {
                        modal.hide();
                    }
                    if (response && response.success) {
                        alert(response.message || 'Reserva eliminada correctamente');
                        loadReservaList();
                    } else {
                        alert(response?.message || 'Error desconocido al eliminar la reserva.');
                    }
                },
                error: function (xhr, status, error) {
                    var modalElement = document.getElementById('deleteModal');
                    var modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) {
                        modal.hide();
                    }
                    var errorMessage = 'Error en la solicitud de eliminación: ';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage += xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        try {
                            var errorObj = JSON.parse(xhr.responseText);
                            errorMessage += errorObj.message || error;
                        } catch (e) {
                            errorMessage += error;
                        }
                    } else {
                        errorMessage += error;
                    }
                    alert(errorMessage);
                }
            });
        };
        
        function loadReservaList() {
            try {
                $.get('@Url.Action("_List", "ReservaApi")', function (data) {
                    $("#reserva-list-container").html(data);
                }).fail(function(xhr, status, error) {
                    console.error('Error al cargar la lista de reservas:', error);
                    alert('Error al cargar la lista de reservas. Por favor, recargue la página.');
                });
            } catch (error) {
                console.error('Error en loadReservaList:', error);
                alert('Error al cargar la lista de reservas.');
            }
        }

        $(document).ready(function() {
            try {
                console.log('=== INICIO SCRIPT RESERVAS ===');
                console.log('jQuery disponible:', typeof $ !== 'undefined');
                console.log('Bootstrap disponible:', typeof bootstrap !== 'undefined');
                console.log('openDeleteModal disponible:', typeof window.openDeleteModal === 'function');
                
                if (typeof $ === 'undefined') {
                    console.error('jQuery no está disponible');
                    alert('Error: jQuery no está cargado. Por favor, recargue la página.');
                    return;
                }
                
                if (typeof bootstrap === 'undefined') {
                    console.error('Bootstrap no está disponible');
                    alert('Error: Bootstrap no está cargado. Por favor, recargue la página.');
                    return;
                }
                
                $(document).on('click', '.btn-delete-reserva', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var id = $(this).data('reserva-id');
                    console.log('Botón eliminar clickeado (delegation), ID:', id);
                    if (id && typeof window.openDeleteModal === 'function') {
                        window.openDeleteModal(id);
                    } else {
                        console.error('ID no válido o función no disponible. ID:', id, 'Función disponible:', typeof window.openDeleteModal);
                        alert('Error: No se pudo obtener el ID o la función no está disponible');
                    }
                });
                
                var hasData = @Html.Raw(Model != null && Model.Any() ? "true" : "false");
                if (!hasData) {
                    console.log('No hay datos en el modelo, cargando lista...');
                    loadReservaList();
                } else {
                    console.log('Datos ya cargados en el modelo');
                }
                console.log('=== FIN SCRIPT RESERVAS ===');
            } catch (error) {
                console.error('Error en document.ready:', error);
                alert('Error al inicializar la página. Por favor, recargue la página.');
            }
        });
    </script>
}
