@model SGHR.Web.ViewModels.Reservas.EditReservaViewModel

@{
    ViewData["Title"] = "Editar Reserva";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil"></i> Editar Reserva
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    <form asp-action="Edit" asp-controller="ReservaApi" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="Reserva.Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Reserva.IdCliente" class="form-label fw-bold">Cliente</label>
                                <select asp-for="Reserva.IdCliente" class="form-select">
                                    <option value="">-- Seleccione un Cliente --</option>
                                    @if (Model.Clientes != null && Model.Clientes.Any())
                                    {
                                        foreach (var cliente in Model.Clientes)
                                        {
                                            <option value="@cliente.Id">@cliente.Nombre @cliente.Apellido - @cliente.Identificacion</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="" disabled>No hay clientes disponibles</option>
                                    }
                                </select>
                                @if (Model.Clientes == null || !Model.Clientes.Any())
                                {
                                    <small class="text-warning">No se pudieron cargar los clientes. Por favor, verifique la conexión con la API.</small>
                                }
                                <span asp-validation-for="Reserva.IdCliente" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Reserva.IdHabitacion" class="form-label fw-bold">Habitación</label>
                                <select asp-for="Reserva.IdHabitacion" class="form-select">
                                    <option value="">-- Seleccione una Habitación --</option>
                                    @if (Model.Habitaciones != null && Model.Habitaciones.Any())
                                    {
                                        foreach (var habitacion in Model.Habitaciones)
                                        {
                                            <option value="@habitacion.Id">Habitación #@habitacion.Numero - Piso @habitacion.IdPiso - @habitacion.PrecioBase.ToString("C")</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="" disabled>No hay habitaciones disponibles</option>
                                    }
                                </select>
                                @if (Model.Habitaciones == null || !Model.Habitaciones.Any())
                                {
                                    <small class="text-warning">No se pudieron cargar las habitaciones. Por favor, verifique la conexión con la API.</small>
                                }
                                <span asp-validation-for="Reserva.IdHabitacion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Reserva.FechaInicio" class="form-label fw-bold">Fecha Inicio</label>
                                <input asp-for="Reserva.FechaInicio" class="form-control" type="datetime-local" value="@(Model.Reserva?.FechaInicio.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                                <span asp-validation-for="Reserva.FechaInicio" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Reserva.FechaFin" class="form-label fw-bold">Fecha Fin</label>
                                <input asp-for="Reserva.FechaFin" class="form-control" type="datetime-local" value="@(Model.Reserva?.FechaFin.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                                <span asp-validation-for="Reserva.FechaFin" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Reserva.NumeroHuespedes" class="form-label fw-bold">Número de Huéspedes</label>
                                <input asp-for="Reserva.NumeroHuespedes" class="form-control" type="number" min="1" />
                                <span asp-validation-for="Reserva.NumeroHuespedes" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Reserva.Total" class="form-label fw-bold">Total</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Reserva.Total" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Reserva.Total" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Reserva.EstadoReserva" class="form-label fw-bold">Estado Reserva</label>
                                <select asp-for="Reserva.EstadoReserva" class="form-select">
                                    @if (Model.EstadosReserva != null)
                                    {
                                        foreach (var estado in Model.EstadosReserva)
                                        {
                                            <option value="@estado.Key">@estado.Value</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Reserva.EstadoReserva" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Reserva.Estado" class="form-label fw-bold">Estado</label>
                                <select asp-for="Reserva.Estado" class="form-select">
                                    <option value="true">Activa</option>
                                    <option value="false">Inactiva</option>
                                </select>
                                <span asp-validation-for="Reserva.Estado" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Actualizar
                            </button>
                            <a href="@Url.Action("Index", "ReservaApi")" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
