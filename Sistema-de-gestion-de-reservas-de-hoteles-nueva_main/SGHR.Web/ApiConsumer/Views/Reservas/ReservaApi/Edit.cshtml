@model SGHR.Application.DTOs.Reservas.Reserva.UpdateReservaDTO

@{
    ViewData["Title"] = "Editar Reserva";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil"></i> Editar Reserva
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    <form asp-action="Edit" asp-controller="ReservaApi" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdCliente" class="form-label fw-bold">ID Cliente</label>
                                <input asp-for="IdCliente" class="form-control" type="number" />
                                <span asp-validation-for="IdCliente" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="IdHabitacion" class="form-label fw-bold">ID Habitación</label>
                                <input asp-for="IdHabitacion" class="form-control" type="number" />
                                <span asp-validation-for="IdHabitacion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaInicio" class="form-label fw-bold">Fecha Inicio</label>
                                <input asp-for="FechaInicio" class="form-control" type="datetime-local" value="@Model.FechaInicio.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="FechaInicio" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaFin" class="form-label fw-bold">Fecha Fin</label>
                                <input asp-for="FechaFin" class="form-control" type="datetime-local" value="@Model.FechaFin.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="FechaFin" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="NumeroHuespedes" class="form-label fw-bold">Número de Huéspedes</label>
                                <input asp-for="NumeroHuespedes" class="form-control" type="number" min="1" />
                                <span asp-validation-for="NumeroHuespedes" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Total" class="form-label fw-bold">Total</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Total" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Total" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="EstadoReserva" class="form-label fw-bold">Estado Reserva</label>
                                <select asp-for="EstadoReserva" class="form-select">
                                    <option value="1">Activa</option>
                                    <option value="2">Pendiente</option>
                                    <option value="3">Confirmada</option>
                                    <option value="4">Cancelada</option>
                                    <option value="5">Finalizada</option>
                                    <option value="6">Ausente</option>
                                </select>
                                <span asp-validation-for="EstadoReserva" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Estado" class="form-label fw-bold">Estado</label>
                                <select asp-for="Estado" class="form-select">
                                    <option value="true">Activa</option>
                                    <option value="false">Inactiva</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Actualizar
                            </button>
                            <a href="@Url.Action("Index", "ReservaApi")" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
