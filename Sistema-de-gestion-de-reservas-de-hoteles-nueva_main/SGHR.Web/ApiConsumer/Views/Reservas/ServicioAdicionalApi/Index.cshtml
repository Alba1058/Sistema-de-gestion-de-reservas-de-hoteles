@model List<SGHR.Application.DTOs.Reservas.ServicioAdicional.ServicioAdicionalDTO>

@{
    ViewData["Title"] = "Servicios Adicionales";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="bi bi-bell"></i> Gesti�n de Servicios Adicionales
        </h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a href="@Url.Action("Create", "ServicioAdicionalApi")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Servicio
        </a>
    </div>

    <div id="servicio-list-container">
        @await Html.PartialAsync("_List", Model ?? new List<SGHR.Application.DTOs.Reservas.ServicioAdicional.ServicioAdicionalDTO>())
    </div>
</div>

@Html.AntiForgeryToken()

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" id="deleteModalContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        function loadServicioAdicionalList() {
            $.get('@Url.Action("_List", "ServicioAdicionalApi")', function (data) {
                $("#servicio-list-container").html(data);
            });
        }

        function openDeleteModal(id) {
            $.get('@Url.Action("_Delete", "ServicioAdicionalApi")', { id: id })
                .done(function (html) {
                    $("#deleteModalContent").html(html);
                    $("#deleteModal").modal("show");
                })
                .fail(function (xhr, status, error) {
                    alert('Error al cargar el modal de eliminaci�n: ' + (xhr.responseJSON?.message || error));
                });
        }

        function deleteConfirmed(id) {
            var token = $('input[name="__RequestVerificationToken"]').first().val();
            
            if (!token) {
                alert('Error: No se pudo obtener el token de seguridad. Por favor, recargue la página.');
                return;
            }
            
            $.post('@Url.Action("_DeleteConfirmed", "ServicioAdicionalApi")',
                { id: id, __RequestVerificationToken: token })
                .done(function (response) {
                    $("#deleteModal").modal("hide");
                    if (response && response.success) {
                        alert(response.message || 'Servicio eliminado correctamente');
                        loadServicioAdicionalList();
                    } else {
                        alert(response?.message || 'Error desconocido al eliminar el servicio.');
                    }
                })
                .fail(function (xhr, status, error) {
                    alert('Error en la solicitud de eliminaci�n: ' + error);
                });
        }

        $(document).ready(function() {
            if (@Html.Raw(Model == null ? "true" : "false")) {
                loadServicioAdicionalList();
            }
        });
    </script>
}