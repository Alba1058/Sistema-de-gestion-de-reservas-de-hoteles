@model List<SGHR.Application.DTOs.Reservas.Pago.PagoDTO>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>ID Reserva</th>
                <th>Monto</th>
                <th>Fecha Pago</th>
                <th>Método</th>
                <th>Confirmado</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var pago in Model)
                {
                    <tr>
                        <td>@pago.Id</td>
                        <td>@pago.IdReserva</td>
                        <td class="fw-bold text-success">@pago.Monto.ToString("C")</td>
                        <td>@pago.FechaPago.ToString("dd/MM/yyyy")</td>
                        <td>@pago.Metodo</td>
                        <td>
                            @if (pago.Confirmado)
                            {
                                <span class="badge rounded-pill bg-success">Sí</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-warning text-dark">No</span>
                            }
                        </td>
                        <td>
                            @if (pago.Estado)
                            {
                                <span class="badge rounded-pill bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-nowrap text-center">
                            <a href="@Url.Action("Details", "PagoApi", new { id = pago.Id })" class="btn btn-outline-info btn-sm me-1">
                                <i class="bi bi-eye"></i> Detalles
                            </a>
                            <a href="@Url.Action("Edit", "PagoApi", new { id = pago.Id })" class="btn btn-outline-warning btn-sm me-1">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="openDeleteModal(@pago.Id)">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-4">
                        <div class="text-muted">
                            <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                            <p class="mt-2">No hay pagos registrados</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
