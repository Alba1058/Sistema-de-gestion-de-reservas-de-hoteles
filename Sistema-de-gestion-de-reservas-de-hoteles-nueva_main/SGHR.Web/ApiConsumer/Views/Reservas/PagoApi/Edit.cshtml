@model SGHR.Application.DTOs.Reservas.Pago.UpdatePagoDTO

@{
    ViewData["Title"] = "Editar Pago";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil"></i> Editar Pago
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Edit" asp-controller="PagoApi" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdReserva" class="form-label fw-bold">ID Reserva</label>
                                <input asp-for="IdReserva" class="form-control" type="number" />
                                <span asp-validation-for="IdReserva" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Monto" class="form-label fw-bold">Monto</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Monto" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Monto" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaPago" class="form-label fw-bold">Fecha de Pago</label>
                                <input asp-for="FechaPago" class="form-control" type="datetime-local" value="@Model.FechaPago.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="FechaPago" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Metodo" class="form-label fw-bold">Método de Pago</label>
                                <select asp-for="Metodo" class="form-select">
                                    <option value="">-- Seleccione un método --</option>
                                    <option value="Efectivo">Efectivo</option>
                                    <option value="Tarjeta de Crédito">Tarjeta de Crédito</option>
                                    <option value="Tarjeta de Débito">Tarjeta de Débito</option>
                                    <option value="Transferencia">Transferencia</option>
                                    <option value="Cheque">Cheque</option>
                                </select>
                                <span asp-validation-for="Metodo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Confirmado" class="form-label fw-bold">Confirmado</label>
                                <select asp-for="Confirmado" class="form-select">
                                    <option value="true">Sí</option>
                                    <option value="false">No</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Estado" class="form-label fw-bold">Estado</label>
                                <select asp-for="Estado" class="form-select">
                                    <option value="true">Activo</option>
                                    <option value="false">Inactivo</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Actualizar
                            </button>
                            <a href="@Url.Action("Index", "PagoApi")" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Volver a la Lista
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
