@model SGHR.Application.DTOs.Reservas.Habitacion.HabitacionDTO

@if (Model == null)
{
    <div class="modal-header">
        <h5 class="modal-title">Eliminar Habitación</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div class="alert alert-danger">No se encontró la habitación para eliminar.</div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
    </div>
}
else
{
    <div class="modal-header bg-danger text-white">
        <h5 class="modal-title">
            <i class="bi bi-exclamation-triangle"></i> Eliminar Habitación
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar la habitación <strong>#@Model.Numero</strong>? Esta acción no se puede deshacer.
        </div>
        <dl class="row">
            <dt class="col-sm-4">ID:</dt>
            <dd class="col-sm-8"><strong>@Model.Id</strong></dd>
            <dt class="col-sm-4">Precio Base:</dt>
            <dd class="col-sm-8">@Model.PrecioBase.ToString("C")</dd>
            <dt class="col-sm-4">Estado Actual:</dt>
            <dd class="col-sm-8">@(Model.Estado ? "Activo" : "Inactivo")</dd>
        </dl>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle"></i> Cancelar
        </button>
        <button type="button" class="btn btn-danger" onclick="deleteConfirmed(@Model.Id)">
            <i class="bi bi-trash"></i> Eliminar
        </button>
        @Html.AntiForgeryToken()
    </div>
}