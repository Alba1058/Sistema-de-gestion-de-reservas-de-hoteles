@model SGHR.Application.DTOs.Reservas.Tarifa.TarifaDTO

@{
    ViewData["Title"] = "Detalles de Tarifa";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-info-circle"></i> Detalles de Tarifa: @Model.Tipo
                    </h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">ID:</dt>
                        <dd class="col-sm-8"><strong>@Model.Id</strong></dd>

                        <dt class="col-sm-4 text-muted">Tipo:</dt>
                        <dd class="col-sm-8">@Model.Tipo</dd>

                        <dt class="col-sm-4 text-muted">Monto Total:</dt>
                        <dd class="col-sm-8"><span class="badge bg-success fs-6">@Model.Monto.ToString("C")</span></dd>

                        <dt class="col-sm-4 text-muted">Precio por Noche:</dt>
                        <dd class="col-sm-8">@Model.PrecioPorNoche.ToString("C")</dd>

                        <dt class="col-sm-4 text-muted">Descuento:</dt>
                        <dd class="col-sm-8">@((Model.Descuento * 100).ToString("F0"))%</dd>

                        <dt class="col-sm-4 text-muted">Vigencia:</dt>
                        <dd class="col-sm-8">@Model.FechaInicio.ToShortDateString() - @Model.FechaFin.ToShortDateString()</dd>

                        <dt class="col-sm-4 text-muted">ID Habitación:</dt>
                        <dd class="col-sm-8">@Model.IdHabitacion</dd>

                        <dt class="col-sm-4 text-muted">Descripción:</dt>
                        <dd class="col-sm-8">@Model.Descripcion</dd>

                        <dt class="col-sm-4 text-muted">Estado:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Estado)
                            {
                                <span class="badge rounded-pill bg-success fs-6">Activo</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary fs-6">Inactivo</span>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Edit", "TarifaApi", new { id = Model.Id })" class="btn btn-outline-warning">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a href="@Url.Action("Index", "TarifaApi")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Volver a la lista
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>